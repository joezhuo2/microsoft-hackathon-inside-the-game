{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Match Overlay",
  "version": "0.1.0",
  "identifier": "com.matchintel.overlay",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Match Overlay",
        "width": 1280,
        "height": 720,
        "maximized": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
